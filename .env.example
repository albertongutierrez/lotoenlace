APP_NAME="LotoEnlace"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://lotoenlace.test
APP_TIMEZONE=UTC
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lotoenlace
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
BROADCAST_CONNECTION=log
# Para avisos en vivo, configurar Reverb y cambiar BROADCAST_CONNECTION a reverb.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=lotoenlace.test
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=lotoenlace.test
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=lotoenlace_session
SESSION_SECURE_COOKIE=false

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
ALLOW_REGISTRATION=false

# Solo consorcios de prueba; vacío mantiene las restricciones normales.
